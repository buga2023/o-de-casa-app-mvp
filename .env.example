# Copie para .env (fora do git) e preencha. NUNCA commite .env.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Driver de dados: "local" (demo em localStorage, padrão) ou "supabase".
# Com "supabase": rode db/schema.sql no SQL Editor e habilite o sign-in
# anônimo (Authentication -> Providers -> Anonymous).
NEXT_PUBLIC_DATA_DRIVER=local
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Observabilidade (opcional) — sem DSN o Sentry fica inerte.
NEXT_PUBLIC_SENTRY_DSN=
